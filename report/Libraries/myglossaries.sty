% +   Beispiel für zwei Einträge in der Gruppe GriechBst (griechische Buchstaben) im Glossar main:            +
% +                                                                                                           +
% +   \newglossaryentry{GriechBst}{                             % Bezeichnung der Gruppe                      +
% +   name={griechische Buchstaben},                            % Gruppenüberschrift                          +                                                          
% +   description={\nopostdesc}                                 % Beschreibung leer lassen                    +
% +   }                                                                                                       +
% +                                                                                                           +
% +   \newglossaryentry{alpha}{                                 % Bezeichnung des Eintrags                    +
% +   name=\ensuremath{\alpha},                                 % Anzuzeigendes Symbol                        +
% +   description={erster Buchstabe im griechischen Alphabet},  % Beschreibung                                +
% +   sort=ga,                                                  % Sortierungsschlüssel (g: griechisch)        +
% +   type=main,                                                % Einordnung in das entspr. Glossar           +
% +   parent=GriechBst                                          % Gruppenzugehörigkeit                        +
% +   }                                                                                                       +
% +                                                                                                           +
% +   \newglossaryentry{beta}{                                  % Bezeichnung des Eintrags                    +
% +   name=\ensuremath{\beta},                                  % Anzuzeigendes Symbol                        +
% +   description={zweiter Buchstabe im griechischen Alphabet}, % Beschreibung                                +
% +   sort=gb,                                                  % Sortierungsschlüssel (g: griechisch)        +
% +   type=main,                                                % Einordnung in das entspr. Glossar           +
% +   parent=GriechBst                                          % Gruppenzugehörigkeit                        +
% +   }                                                                                                       +
% +                                                                                                           +
