// ================================================================
// 4C input — virtual stent deployment
// Method: Ranno et al. 2025 (Sci. Rep.) — mixed-dimensional beam-to-solid contact
// stent    : stent1   material : Nitinol
// artery   : s_bend
// load     : 0.0100 N/m radially outward over 100 steps
// nodes    : 28222 stent + 9666 artery = 37888 total
// elements : 29004 BEAM3R + 19328 TRI3 = 48332 total
// unit system : mm – N – tonne
// ================================================================

--PROBLEM TYP
PROBLEMTYPE                     Structure
RESTART                         0

--IO
OUTPUT_BIN                      Yes
STRUCT_DISP                     Yes
STRUCT_STRESS                   cauchy
STRUCT_STRAIN                   gl
FILESTEPS                       1
STDOUTEVERY                     1

--FUNCT1
SYMBOLIC_FUNCTION_OF_TIME t

--STRUCTURAL DYNAMIC
INT_STRATEGY                    Standard
DYNAMICTYPE                     Statics
RESULTSEVERY                    1
RESTARTEVERY                    10
NLNSOL                          fullnewton
NUMSTEP                         100
TIMESTEP                        0.01000000
MAXTIME                         1.0
TOLRES                          1.0e-8
TOLDISP                         1.0e-8
MAXITER                         50

--SOLVER 1
NAME                            Structure_Solver
SOLVER                          Superlu

--BEAM INTERACTION/BEAM TO SOLID SURFACE CONTACT
// TODO: verify section name and keywords against your 4C version
PENALTY_PARAMETER               1.00e+05
INTEGRATION_SEGMENTS            5
STRATEGY                        Penalty

--PROBLEM SIZE
ELEMENTS                        48332
NODES                           37888

--MATERIALS
// MAT 1 — stent strut: Nitinol  r_strut = 0.0655 mm  (circular cross-section)
MAT 1 MAT_BeamReissnerElastHyper YOUNG 50000.0000 POISSONRATIO 0.330000 DENSITY 6.450000e-09 CROSSSEC 0.01347487 SHEARCORR 0.9000 MOMINPOL 0.0000288981 MOMIN2 0.0000144490 MOMIN3 0.0000144490
// MAT 2 — artery wall (rigid first pass — all DOFs fixed via BC)
//   Upgrade to HGO-C hyperelastic (Holzapfel-Gasser-Ogden) for deformable artery.
//   Paper values (human coronary, Ranno et al. 2025):
//     Media (0.4 mm): μ_matrix=0.06 MPa, fibers=0.112 MPa, exp.coeff=20.61, angle=41°
//     Adventitia    : μ_matrix=0.024 MPa, fibers=0.362 MPa, exp.coeff=7.089, angle=50.1°
MAT 2 MAT_Struct_StVenantKirchhoff YOUNG 1.0 NUE 0.45 DENS 1.0e-6

